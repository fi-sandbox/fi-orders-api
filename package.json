{
  "name": "fi-orders-api",
  "version": "1.0.0",
  "private": false,
  "description": "Orders API — order processing service (Node.js/Express), high test coverage",
  "license": "MIT",
  "main": "src/app.js",
  "scripts": {
    "test": "jest"
  },
  "dependencies": {
